# ==============================================================================
# DeliveryApp — Environment Configuration
#
# Copy this file to `.env` for local development:
#   cp .env.example .env
#
# NEVER commit a real `.env` file. All values below are placeholders/dev
# defaults; see src/lib/env.ts for full validation rules and README.md for
# setup instructions per provider.
# ==============================================================================

NODE_ENV=development
APP_URL=http://localhost:3000

# --- Database (PostgreSQL via Docker Compose by default) --------------------
DATABASE_URL=postgresql://deliveryapp:deliveryapp@localhost:5432/deliveryapp

# --- Redis (cache, rate limiting, queues, realtime pub/sub) ------------------
REDIS_URL=redis://localhost:6379

# --- Sessions / cookies -------------------------------------------------------
SESSION_COOKIE_NAME=dapp_session
CSRF_COOKIE_NAME=dapp_csrf
SESSION_TTL_DAYS=30
# Leave unset in local dev (defaults to false outside production, true in prod).
FORCE_SECURE_COOKIES=false

# --- Object storage (S3-compatible; MinIO locally, real S3/DO Spaces in prod)
# STORAGE_PROVIDER=mock uses an in-memory adapter that never persists files —
# suitable only for tests. Local development should use "s3" pointed at MinIO.
STORAGE_PROVIDER=s3
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=deliveryapp-media
S3_ACCESS_KEY_ID=deliveryapp
S3_SECRET_ACCESS_KEY=deliveryapp123
S3_PUBLIC_BASE_URL=http://localhost:9000/deliveryapp-media
S3_FORCE_PATH_STYLE=true

# --- Map provider (server-side only; the API key is NEVER sent to the client)
# MAP_PROVIDER=mock renders a functional stub map layer for local dev without
# any external API key. Set to "mapbox" + MAPBOX_SERVER_TOKEN for real maps.
MAP_PROVIDER=mock
MAPBOX_SERVER_TOKEN=

# --- Payments (PaymentProvider abstraction; see src/modules/payments) -------
# PAYMENT_DEFAULT_PROVIDER=mock is a fully functional in-process simulator —
# it never charges real money and is isolated from the Payme/Click adapters.
PAYMENT_DEFAULT_PROVIDER=mock
PAYME_MERCHANT_ID=
PAYME_SECRET_KEY=
CLICK_MERCHANT_ID=
CLICK_SERVICE_ID=
CLICK_SECRET_KEY=

# --- SMS (phone OTP delivery) -------------------------------------------------
# SMS_PROVIDER=console logs OTP codes to the server console instead of
# sending real SMS — use this for local development.
SMS_PROVIDER=console
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
